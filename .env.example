# Speedo Centralized Backend Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL on Railway or Local)
# When DATABASE_URL is set, the app connects to PostgreSQL.
# If unset or empty in development, it automatically uses built-in SQLite (./speedo.db) for zero-setup local dev.
DATABASE_URL=

# JWT Secret Key for token signing
JWT_SECRET=speedo_super_secret_jwt_key_rapido_2025_prod_safe

# Uploads Configuration
# Set to 'local' for local disk uploads or 'cloudinary' for cloud storage
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
BASE_URL=http://10.0.2.2:5000

# Cloudinary (Optional, for production cloud storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
